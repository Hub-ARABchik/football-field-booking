@startuml
title FFBS — Package Diagram
skinparam packageStyle rectangle
skinparam shadowing false

package "Уровень представления" {
  package "Интерфейс клиента"
  package "Панель владельца площадки"
  package "Панель администратора"
}

package "Уровень приложения" {
  package "Аутентификация"
  package "Управление пользователями"
  package "Управление площадками"
  package "Управление доступностью"
  package "Управление бронированиями"
  package "Управление платежами"
  package "Управление уведомлениями"
  package "Управление отзывами"
  package "Формирование отчётности"
}

package "Предметная область" {
  package "Пользователи"
  package "Площадки"
  package "Бронирования"
  package "Платежи"
  package "Отзывы"
}

package "Инфраструктура" {
  package "Хранение данных"
  package "Файловое хранилище"
  package "Внешние интеграции"
}

"Уровень представления" ..> "Уровень приложения"
"Уровень приложения" ..> "Предметная область"
"Уровень приложения" ..> "Инфраструктура"
"Предметная область" ..> "Предметная область"
@enduml
