@startuml
title FFBS — Логическая ER-диаграмма (нотация Crow's Foot)
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
  BackgroundColor White
  BorderColor Black
}

entity "Пользователи (users)" as users {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(255)
  email : VARCHAR(255) <<UQ>>
  phone : VARCHAR(30)
  password_hash : VARCHAR(255)
  role : VARCHAR(20)
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Футбольные площадки (fields)" as fields {
  * id : BIGINT <<PK>>
  --
  owner_id : BIGINT <<FK>>
  name : VARCHAR(255)
  description : TEXT
  address : VARCHAR(500)
  city : VARCHAR(100)
  capacity : SMALLINT
  hourly_price : DECIMAL(10,2)
  status : VARCHAR(20)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Фотографии площадок (field_images)" as field_images {
  * id : BIGINT <<PK>>
  --
  field_id : BIGINT <<FK>>
  image_path : VARCHAR(500)
  sort_order : SMALLINT
  created_at : TIMESTAMP
}

entity "Расписание площадок (field_schedules)" as field_schedules {
  * id : BIGINT <<PK>>
  --
  field_id : BIGINT <<FK>>
  day_of_week : TINYINT
  start_time : TIME
  end_time : TIME
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Бронирования (bookings)" as bookings {
  * id : BIGINT <<PK>>
  --
  customer_id : BIGINT <<FK>>
  field_id : BIGINT <<FK>>
  start_at : DATETIME
  end_at : DATETIME
  total_price : DECIMAL(10,2)
  status : VARCHAR(20)
  customer_note : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Платежи (payments)" as payments {
  * id : BIGINT <<PK>>
  --
  booking_id : BIGINT <<FK>>
  amount : DECIMAL(10,2)
  method : VARCHAR(20)
  status : VARCHAR(20)
  provider_reference : VARCHAR(255) <<UQ>>
  paid_at : DATETIME
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Отзывы (reviews)" as reviews {
  * id : BIGINT <<PK>>
  --
  booking_id : BIGINT <<FK, UQ>>
  customer_id : BIGINT <<FK>>
  field_id : BIGINT <<FK>>
  rating : TINYINT
  comment : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Уведомления (notifications)" as notifications {
  * id : BIGINT <<PK>>
  --
  user_id : BIGINT <<FK>>
  booking_id : BIGINT <<FK, nullable>>
  title : VARCHAR(255)
  message : TEXT
  is_read : BOOLEAN
  created_at : TIMESTAMP
}

users ||--o{ fields : владеет
fields ||--o{ field_images : содержит
fields ||--o{ field_schedules : определяет
users ||--o{ bookings : создаёт
fields ||--o{ bookings : принимает
bookings ||--o{ payments : имеет
bookings ||--o| reviews : может получать
users ||--o{ reviews : оставляет
fields ||--o{ reviews : получает
users ||--o{ notifications : получает
bookings |o--o{ notifications : связаны с

note bottom of bookings
  Активные статусы:
  PENDING (Ожидает подтверждения) и
  CONFIRMED (Подтверждено).
  Предотвращение пересечения бронирований
  должно обеспечиваться транзакционно.
end note

note bottom of field_schedules
  Повторяющееся еженедельное расписание.
  Фактические бронирования хранятся
  в таблице bookings с конкретными датами.
end note
@enduml
