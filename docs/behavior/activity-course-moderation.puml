@startuml activity-course-moderation
title Создание курса и его модерация

|Автор|
start
repeat
  :Ввод данных курса\n(название, описание, категория);
  :Добавление модулей и уроков;
  :Отправка курса на модерацию;
  |Платформа|
  :Проверка обязательных полей;
  if (Все ли данные заполнены?) then (нет)
    :Отображение ошибок валидации;
    |Автор|
    :Исправление неполных данных;
  else (да)
    break
  endif
repeat while (Данные заполнены не полностью)

|Платформа|
:Сохранение курса со статусом pending\n(status = pending);

|Администратор|
:Проверка содержимого и качества курса;
if (Администратор подтверждает курс?) then (да)
  |Платформа|
  :Изменение статуса на published\n(status = published);
  :Публикация курса в общем каталоге;
else (нет)
  |Администратор|
  :Сохранение причины отклонения курса;
  |Платформа|
  :Изменение статуса на rejected\n(status = rejected);
  :Отправка уведомления с причиной отклонения;
endif

|Автор|
:Просмотр результата модерации;
stop
@enduml
