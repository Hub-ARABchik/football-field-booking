@startuml sequence-course-submission
title Отправка созданного курса на модерацию

actor "Автор\n(author)" as Author
participant "Браузер" as Browser
participant "Laravel Router &\nCourseController" as Controller
participant "CourseRepository" as Repo
database "MariaDB\n(kurskhoi_online)" as DB

Author -> Browser : Нажимает кнопку «Отправить на модерацию»
Browser -> Controller : POST /author/courses\n(_token CSRF, course_data)
activate Controller

Controller -> Controller : Проверка роли пользователя (auth check: role == 'author')\nи проверка CSRF-токена

alt #MistyRose Роль author не подтверждена (Unauthorized)
  Controller --> Browser : 403 Forbidden
  Browser --> Author : Отображение сообщения об ошибке доступа (403)
else #LavenderBlush Обязательные данные заполнены не полностью (Validation error)
  Controller -> Controller : Валидация полей (название, модуль, урок)
  Controller --> Browser : 422 Unprocessable Entity\n(ошибки валидации)
  Browser --> Author : Отображение полей формы с ошибками
else #Honeydew Данные корректны, разрешение подтверждено (Успешно)
  Controller -> Repo : createOrSubmit(courseData, status='pending')
  activate Repo

  Repo -> DB : INSERT INTO courses\n(title, description, author_id, status)\nVALUES (?, ?, ?, 'pending')
  activate DB
  DB --> Repo : ID сохранённой записи курса
  deactivate DB

  Repo --> Controller : Объект курса со статусом pending
  deactivate Repo

  Controller --> Browser : 302 Found → /author/courses\n(Сообщение об успешном выполнении)
  deactivate Controller

  Browser --> Author : Страница курсов с отметкой «pending»
end

@enduml
